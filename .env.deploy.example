# .env.deploy — configuração do publishdocker.sh. Copie para .env.deploy e preencha.
# NÃO versione o .env.deploy: ele nomeia host e caminhos do ambiente real.
# Segredos NÃO ficam aqui — vivem em ENVFILE, no servidor (600, só o dono lê).

# Servidor de destino, no formato do ssh (alias do ~/.ssh/config serve).
DEPLOY_HOST=DEFINIR_HOST_AQUI

# Onde o código é espelhado e buildado no servidor (relativo ao home do usuário).
BUILD_DIR=build/socialtool

# Porta publicada no LOOPBACK do servidor. O túnel/proxy reverso aponta para ela.
PORTA=5185

# Arquivo de ambiente COM OS SEGREDOS, no servidor (modelo das chaves em .env.example).
ENVFILE=/etc/socialtool/api.env

# Caixa de e-mail interna (Mailpit): on/off e porta da interface no loopback do servidor.
MAILPIT=on
MAILPIT_UI_PORTA=8026

# Endereço público, usado só na conferência final do publish.
URL=https://socialtool.suaempresa.com.br

# Só esta branch é publicada.
PUBLISH_BRANCH=main

# Em servidor que exige sudo para o docker, use: DK="sudo docker"
DK=docker
