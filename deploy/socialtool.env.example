# Modelo do arquivo de ambiente do servidor. Copie para FORA do repositório (ex.: ~/socialtool/socialtool.env),
# deixe só o seu usuário ler (chmod 600) e preencha. Gere segredos com: openssl rand -base64 48

# ---- Banco (MySQL do próprio compose) ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=socialtool
MYSQL_USER=socialtool
MYSQL_PASSWORD=

# ---- Aplicação ----
JWT_SECRET_KEY=
PUBLIC_URL=https://socialtool.suaempresa.com.br
APP_PORT=5185
# true quando o app só é acessível através de um proxy reverso ou túnel (lê o IP real do X-Forwarded-For)
BEHIND_PROXY=true
GOOGLE_CLIENT_ID=

# ---- Primeira subida: cria a organização e o primeiro administrador se o banco estiver vazio ----
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_GOOGLE_WORKSPACE_DOMAINS=

# ---- E-mail ----
# Padrão seguro: envio desligado. Com EMAIL_ENABLED=true e o desvio ligado, TODO e-mail vai para
# EMAIL_REDIRECT_TO. Só EMAIL_REDIRECT_ENABLED=false entrega aos usuários reais.
EMAIL_ENABLED=false
EMAIL_REDIRECT_ENABLED=true
EMAIL_REDIRECT_TO=
EMAIL_FROM_ADDRESS=no-reply@socialtool.local
# mailpit = caixa interna desta instalação (nada sai). Troque pelo seu SMTP para envio real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
MAILPIT_UI_PORT=8025
