# Copie para deploy/.env.deploy (fora do git) e preencha.
# Host SSH do servidor (um alias do ~/.ssh/config serve)
DEPLOY_HOST=
# Pasta no servidor, relativa ao home do usuário SSH
REMOTE_DIR=socialtool
# Arquivo de ambiente NO SERVIDOR (modelo: deploy/socialtool.env.example)
SERVER_ENV_FILE=~/socialtool-config/socialtool.env
# URL pública, só para a conferência final
PUBLIC_URL=
PUBLISH_BRANCH=main
