# SocialTool RH — variáveis de ambiente
# Copie para .env e ajuste conforme necessário. O arquivo .env é ignorado pelo git.
#
# uso:
#   cp .env.example .env
#   docker compose up -d

# ---- MySQL (docker-compose.yml) ----
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_DATABASE=socialtool
MYSQL_USER=socialtool
MYSQL_PASSWORD=socialtool_dev
MYSQL_PORT=3306

# ---- Adminer (UI web para inspecionar o banco em http://localhost:8080) ----
ADMINER_PORT=8080

# ---- Mailpit (caixa de e-mail de desenvolvimento em http://localhost:8025) ----
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# ---- Backend (ASP.NET Core) ----
# O docker compose não lê as linhas abaixo: elas são para exportar no shell (ou no ambiente de deploy)
# antes do `dotnet run`. Qualquer chave do appsettings.json vira variável trocando ":" por "__".
#
# ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=socialtool;User=socialtool;Password=socialtool_dev;CharSet=utf8mb4;
# Jwt__SecretKey=gere-um-segredo-proprio-com-pelo-menos-32-bytes
# App__PublicUrl=http://localhost:3000
#
# Login com Google Workspace (opcional):
# Auth__Google__ClientId=123456789-abc.apps.googleusercontent.com
#
# Envio de e-mails: DESLIGADO por padrão (nada é enviado). Ligue só quando for para enviar de verdade.
# Email__Enabled=true
# Desvio (ligado por padrão): TODO e-mail vai para este endereço, nunca para o usuário real.
# Email__Redirect__To=voce@empresa.com.br
# Só desligue o desvio quando for para os usuários receberem de verdade:
# Email__Redirect__Enabled=false
#
# SMTP real (fora de desenvolvimento):
# Email__Smtp__Host=smtp.seuprovedor.com
# Email__Smtp__Port=587
# Email__Smtp__User=
# Email__Smtp__Password=
# Email__FromAddress=no-reply@suaempresa.com.br
#
# Organização e primeiro administrador (só na primeira subida, com o banco vazio; manda o convite por e-mail):
# Bootstrap__OrganizationName=Minha Empresa
# Bootstrap__AdminName=Nome do Admin
# Bootstrap__AdminEmail=admin@minhaempresa.com.br
# Bootstrap__GoogleWorkspaceDomains=minhaempresa.com.br,minhaempresa.com   # um ou mais, separados por vírgula
